# ==============================================================================
# 纸间 · Paper Room 环境变量配置模版
# 复制本文件为 .env 并按需修改：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心权限与安全（必看）
# ------------------------------------------------------------------------------

# 馆长访问口令（留空则为内网免密模式；设置后全站开启门禁，提供此口令获得收录/删除/编辑等全部管理权限）
COMIC_SHELF_SECRET=

# 访客阅览口令（可选；留空则仅馆长可进；设置后允许朋友输入此口令只读看书，隐藏一切管理写操作）
COMIC_SHELF_GUEST_SECRET=

# 允许从服务器本地路径扫描导入的额外根目录白名单（安全沙箱放行）
# 多个路径在 Linux/macOS 使用冒号 ":" 分隔，Windows 使用分号 ";" 分隔
# 示例: /mnt/tank/comics:/mnt/media/downloads
COMIC_SHELF_ALLOWED_DIRS=

# 是否开启基于 Sec-Fetch-Site 与 Referer 的图片防盗链拦截（默认 true，彻底防止第三方外站把纸间当图床）
COMIC_SHELF_ENABLE_HOTLINK_PROTECTION=true

# ------------------------------------------------------------------------------
# 2. 基础服务与数据持久化
# ------------------------------------------------------------------------------

# 数据持久化目录（宿主机本地路径；Docker 容器内默认为 /app/data）
COMIC_SHELF_DATA=backend/data

# 服务绑定地址与端口（宿主机运行默认 127.0.0.1，Docker 容器内需为 0.0.0.0）
COMIC_SHELF_HOST=127.0.0.1
COMIC_SHELF_PORT=8000

# 以图搜图 Sidecar 服务地址（未启用时纸间常规功能 100% 正常；Compose 部署时为 http://imsearch:8765）
COMIC_SHELF_IMSEARCH_URL=http://localhost:8765

# 是否开放 FastAPI 交互式 API 文档 (/docs 与 /redoc)
COMIC_SHELF_ENABLE_DOCS=false

# ------------------------------------------------------------------------------
# 3. 性能调优与并发门禁（高级配置，按需修改）
# ------------------------------------------------------------------------------

# 远端图片下载并发数（默认 3；JM CDN 对突发并发极为敏感，建议保持 2~4，避免被限流屏蔽）
COMIC_SHELF_MAX_CONCURRENT_DOWNLOADS=3

# 缩略图生成并发门禁（默认 4；限制同时进行 Pillow 转换的 worker 数，低配 NAS 可降至 1~2 防 CPU 占满）
COMIC_SHELF_THUMB_CONCURRENCY=4

# 一键“缓存全部”单本最大下载页数上限（默认 600）
COMIC_SHELF_MAX_PREFETCH=600

# 详情页缩略图规格（宽度 px 与 JPEG 质量）
COMIC_SHELF_PAGE_THUMB_WIDTH=360
COMIC_SHELF_PAGE_THUMB_QUALITY=78

# 书架封面图规格（宽度 px、JPEG 质量与默认生成封面数量）
COMIC_SHELF_COVER_WIDTH=840
COMIC_SHELF_COVER_QUALITY=82
COMIC_SHELF_COVER_COUNT=4

# Uvicorn 进程数与日志级别
COMIC_SHELF_WORKERS=1
COMIC_SHELF_LOG_LEVEL=info
