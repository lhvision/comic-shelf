{
  "name": "@lhvision/comic-shelf",
  "version": "0.0.0",
  "private": true,
  "author": "lhvision",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "dev:all": "bash scripts/dev.sh",
    "reindex:image": "bash scripts/reindex.sh",
    "build": "run-p type-check \"build-only {@}\" --",
    "setup:py": "python3 -m venv .venv && .venv/bin/pip install -r backend/requirements.txt",
    "preview": "vp preview",
    "api": "bash -c 'PYTHON=\"\"; for cand in .venv/bin/python ../.venv/bin/python backend/.venv/bin/python; do [ -x \"$cand\" ] && PYTHON=\"$cand\" && break; done; ${PYTHON:-python3} backend/server.py --reload'",
    "test:unit": "vp test",
    "test:py": "bash -c 'PYTHON=\"\"; for cand in .venv/bin/python ../.venv/bin/python backend/.venv/bin/python; do [ -x \"$cand\" ] && PYTHON=\"$cand\" && break; done; ${PYTHON:-python3} backend/check_backend.py && ${PYTHON:-python3} backend/test_auth.py && ${PYTHON:-python3} backend/test_incremental_update.py && ${PYTHON:-python3} backend/test_visibility_discovery.py && ${PYTHON:-python3} backend/test_imsearch.py'",
    "critique": "node scripts/critique.mjs",
    "detect:slop": "node scripts/detect.mjs --json",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "vp lint . --fix",
    "lint:eslint": "vp lint . --fix",
    "format": "vp fmt src/",
    "prepare": "vp config",
    "ai-e2e:test": "ai-e2e run",
    "ai-e2e:doctor": "ai-e2e doctor",
    "ai-e2e:chrome": "ai-e2e chrome",
    "ai-e2e:platform": "ai-e2e platform",
    "ai-e2e:yaml": "ai-e2e yaml"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@lhvision/ai-e2e-base": "^0.1.5",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^16.4.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plus": "catalog:",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
