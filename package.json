{
  "name": "@lhvision/comic-shelf",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "lhvision",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "dev:all": "bash scripts/dev.sh",
    "reindex:image": "bash scripts/reindex.sh",
    "imsearch": "bash scripts/imsearch.sh",
    "ocr": "bash scripts/ocr.sh",
    "ocr:sync": "bash scripts/ocr.sh sync",
    "build": "run-p type-check \"build-only {@}\" --",
    "setup:py": "uv venv --seed --allow-existing && uv sync --inexact",
    "preview": "vp preview",
    "api": "bash scripts/api.sh",
    "test:unit": "vp test",
    "test:py": "bash scripts/test_py.sh",
    "check:py": "uv run ruff check && uv run ruff format --check",
    "critique": "vpx scripts/critique.mjs",
    "detect:slop": "vpx scripts/detect.mjs --json",
    "detect:perf": "vpx scripts/detect-perf.mjs",
    "build-only": "vp build",
    "build:ext": "vpx scripts/build-extension.mjs",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "vp lint . --fix",
    "lint:eslint": "vp lint . --fix",
    "format": "vp fmt src/",
    "prepare": "vp config",
    "ai-e2e:test": "ai-e2e run",
    "ai-e2e:doctor": "ai-e2e doctor",
    "ai-e2e:chrome": "ai-e2e chrome",
    "ai-e2e:platform": "ai-e2e platform",
    "ai-e2e:yaml": "ai-e2e yaml"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "vue": "catalog:",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@lhvision/ai-e2e-base": "^0.1.5",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node26": "^26.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^16.6.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.4",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "catalog:",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
